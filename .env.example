# Copie para .env e preencha (o .env NÃO vai pro GitHub)
# ID do cliente OAuth (Google Cloud > APIs e serviços > Credenciais)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# ID da planilha da BASE_CONSOLIDADA (trecho da URL entre /d/ e /edit)
VITE_PLANILHA_ID=
# Planilha de produção (GMCG) e planilha com a aba PERFIS (opcional)
VITE_PLANILHA_PRODUCAO_ID=
VITE_PLANILHA_PERFIS_ID=
